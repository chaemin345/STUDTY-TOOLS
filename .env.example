# Supabase Auth + database (production values must remain in Production scope only)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Legacy aliases remain supported during migration.
# SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# 32-byte random key as 64 hex characters. Generate with: openssl rand -hex 32
INTEGRATION_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS

# Optional: the one Google account that gets unlimited master access.
MASTER_GOOGLE_EMAIL=

# Vercel Preview / Development backend is disabled by default.
# Enable only after provisioning a separate non-production Supabase project.
STUDTY_ALLOW_NON_PRODUCTION_BACKEND=false
# Required in Preview/Development when opting in:
# STUDTY_PRODUCTION_SUPABASE_PROJECT_REF=<production-project-ref>
# STUDTY_PRODUCTION_SUPABASE_SECRET_SHA256=<sha256 of production Supabase secret/service-role key>
# STUDTY_PRODUCTION_ENCRYPTION_KEY_SHA256=<sha256 of production INTEGRATION_ENCRYPTION_KEY>
# Configure the fingerprints in Vercel Preview/Development settings; never paste raw production secrets there.
# Preview/Development must also have its own SUPABASE_URL, SUPABASE_SECRET_KEY,
# and INTEGRATION_ENCRYPTION_KEY. The runtime compares their fingerprints and project ref.
