# Supabase Auth + database
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Legacy aliases are also accepted when migrating existing projects.
# SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Toss Payments: matching client/secret pair. Start with test keys.
TOSS_CLIENT_KEY=test_ck_...
TOSS_SECRET_KEY=test_sk_...

# 32-byte random key as 64 hex characters. Generate with: openssl rand -hex 32
INTEGRATION_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS

# Optional: the one Google account that gets unlimited master access.
MASTER_GOOGLE_EMAIL=
